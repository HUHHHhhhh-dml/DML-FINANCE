# DML-FINANCE - ejemplo de variables de entorno.
# Copia este archivo como ".env" (nunca lo subas a un repositorio) y rellena
# solo las claves que vayas a usar. Todas son OPCIONALES.

# Respaldo de tasas con la API oficial de FRED.
# Sin ella, la aplicacion descarga el CSV publico fredgraph.csv, que no requiere clave.
FRED_API_KEY=

# Multiplos fundamentales alternativos (PER, Price to FCF, dividend yield).
FMP_API_KEY=

# PER alternativo desde Finnhub.
FINNHUB_API_KEY=

# Carpeta donde se guarda la cache local por dia (por defecto ~/.dml_finance).
# DML_FINANCE_HOME=
